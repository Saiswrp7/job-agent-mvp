{"id": "city-plain", "say": "growth roles in Bangalore", "expect": {"city": "Bangalore"}}
{"id": "city-spelling", "say": "any growth jobs in Bengaluru", "expect": {"city": "Bangalore"}, "means": "Bengaluru and Bangalore are the same place. If only one works, half your searches come back empty for no reason."}
{"id": "count-three", "say": "find me 3 growth roles", "expect": {"count": 3}}
{"id": "count-ten", "say": "show me 10 product jobs", "expect": {"count": 10}}
{"id": "count-default", "say": "growth jobs please", "expect": {"count": 5}}
{"id": "recency-week", "say": "growth roles posted in the last 7 days", "expect": {"posted_within_days": 7}}
{"id": "recency-month", "say": "anything from the last month", "expect": {"posted_within_days": 30}}
{"id": "title-growth", "say": "growth manager roles", "expect_contains": {"title_keywords": "growth"}}
{"id": "title-product", "say": "product manager jobs", "expect_contains": {"title_keywords": "product"}}
{"id": "remote", "say": "remote only please", "expect": {"remote": true}}
{"id": "company-named", "say": "anything open at Meesho", "expect_contains": {"companies": "Meesho"}}
{"id": "b2c", "say": "growth roles at B2C companies", "expect": {"company_type": "b2c"}}
{"id": "no-city-invented", "say": "growth roles anywhere", "expect": {"city": null}, "means": "It would quietly limit you to one city you never named, hiding jobs you would have wanted."}
{"id": "no-date-invented", "say": "growth manager jobs", "expect": {"posted_within_days": null}, "means": "It would quietly ignore older postings you never asked it to skip."}
{"id": "soft-kept", "say": "growth roles, nothing CRM-heavy", "expect_nonempty": ["soft_criteria"], "means": "The part of your sentence that is a preference rather than a filter gets lost, so 'nothing CRM-heavy' stops being taken into account."}
{"id": "country-india", "say": "growth roles anywhere in India", "expect_country": "India", "means": "Jobs in London and San Mateo get shortlisted. The AI reads all of them and throws them out afterwards, so you pay for descriptions that were never eligible."}
{"id": "count-and-country", "say": "find me 3 growth roles anywhere in India", "expect": {"count": 3}, "expect_country": "India", "means": "You asked for a number and a place. If either is dropped you get a different list than the one you asked for, and nothing says so."}
{"id": "tg-posted-today", "source": "Telegram, Sai 24 Sep", "say": "Growth Roles which posted today", "expect": {"posted_within_days": 1, "city": null}, "expect_role": [["growth"]]}
{"id": "tg-only-growth", "source": "Telegram, Sai 24 Sep (bug 5)", "say": "Can you find only growth roles ?", "profile": "Lives in Bengaluru. Growth Manager at Lenskart, 4+ years.", "expect": {"city": null, "posted_within_days": null}, "expect_role": [["growth"]], "means": "Knowing where you live is not the same as you asking for that city. Adding it hides every remote and other-city job."}
{"id": "tg-founder-office", "source": "Telegram, Sai 24 Sep (bug 5)", "say": "Find founder office roles, recency should be 7 to 10 days", "profile": "Lives in Bengaluru. Growth Manager at Lenskart, 4+ years.", "expect": {"city": null}, "expect_one_of": {"posted_within_days": [7, 10]}, "expect_role": [["founder", "chief of staff"]]}
{"id": "tg-new-jobs", "source": "Telegram, Sai 25 Sep", "say": "Cool he. Find new jobs ?", "profile": "Lives in Bengaluru. Growth Manager at Lenskart, 4+ years.", "expect": {"city": null}, "allow": ["posted_within_days", "title_keywords", "role_family"], "means": "No city added. Guessing the role from your profile is fine (Sai, 28 Sep): you asked for new jobs and the bot knows what you do."}
{"id": "log-3-growth-apm", "source": "chat log, 22 Sep", "say": "find me 3 growth or APM roles in Bangalore", "expect": {"count": 3, "city": "Bangalore"}, "expect_role": [["growth"], ["apm", "associate product", "product"]], "allow": ["country"]}
{"id": "log-2-fintech", "source": "chat log, 22 Sep", "say": "find me 2 product roles at fintech companies", "expect": {"count": 2, "city": null}, "expect_like": {"industry": "fintech"}, "expect_role": [["product"]]}
{"id": "log-any-growth-blr", "source": "chat log, 22 Sep", "say": "any growth roles in Bangalore?", "expect": {"city": "Bangalore", "count": 5, "posted_within_days": null}, "expect_role": [["growth"]], "allow": ["country"]}
{"id": "bug5-remote", "source": "bug 5 variant", "say": "remote growth roles", "profile": "Lives in Bengaluru. Growth Manager at Lenskart, 4+ years.", "expect": {"remote": true, "city": null}, "expect_role": [["growth"]]}
{"id": "bug5-plain", "source": "bug 5 variant", "say": "show me product jobs", "profile": "Lives in Bengaluru. Growth Manager at Lenskart, 4+ years.", "expect": {"city": null}, "expect_role": [["product"]]}
